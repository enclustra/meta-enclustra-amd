/ {
	aliases {
		ethernet0 = &gem3;
		i2c0 = &i2c0;
		serial0 = &uart0;
		spi0 = &qspi;
	};
};

&i2c0 {
	clock-frequency = <100000>;

	epc@54 {
		status = "okay";
		reg = <0x54>;
	};
};

&gem3 {
	status = "okay";
	/delete-property/ local-mac-address;
	phy-mode = "rgmii-id";
	phy-handle = <&phy0>;
	mdio {
		phy0: phy@1 {
			reg = <1>;
			realtek,center-tap-not-short;
		};
	};
};

&qspi {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	is-dual = <0>;
	num-cs = <1>;

	flash0: flash@0 {
		reg = <0x0>;
		compatible = "micron,mt25qu512", "jedec,spi-nor";
		spi-rx-bus-width = <0x4>;
		spi-tx-bus-width = <0x4>;
		spi-max-frequency = <50000000>;
		#address-cells = <1>;
		#size-cells = <1>;
	};
};

&psgtr {
	status = "okay";
	clocks = <&ref100>, <&ref135>;
	clock-names = "ref0", "ref1";
};

&amba {
	ref100: ref100M {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <100000000>;
	};
	ref135: ref135M {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <135000000>;
	};
};