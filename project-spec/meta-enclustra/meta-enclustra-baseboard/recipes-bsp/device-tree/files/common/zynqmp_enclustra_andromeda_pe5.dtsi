#include <dt-bindings/phy/phy.h>

&i2c_mgmt {
	i2c-mux@74 {
		compatible = "nxp,pca9547";
		reg = <0x74>;
		#address-cells = <1>;
		#size-cells = <0>;

		i2c-mux@0 {
			reg = <0>;
			ioexpander0: gpio@20 {
				status = "disabled";
				compatible = "nxp,pcal6416";
				reg = <0x20>;
				gpio-controller;
				#gpio-cells = <2>;
			};
			ioexpander1: gpio@21 {
				status = "disabled";
				compatible = "nxp,pcal6416";
				reg = <0x21>;
				gpio-controller;
				#gpio-cells = <2>;
			};
			fanctl: lm96063@4c {
				status = "disabled";
				compatible = "national,lm96163";
				reg = <0x4c>;
			};	
			system_monitor: lm96080@2f {
				status = "okay";
				compatible = "national,lm80";
				reg = <0x2f>;
			};
			irps5401@46 {
				status = "okay";
				compatible = "infineon,irps5401";
				reg = <0x4e>;
			};
			irps5401@52 {
				status = "okay";
				compatible = "infineon,irps5401";
				reg = <0x47>;
			};
			eeprom@56 {
				status = "disabled";
				compatible = "atmel,24c128";
				reg = <0x56>;	
			};
			si5332: si5332@6a {
				status = "disabled";
				reg = <0x6a>;
			};
		};
		i2c-mux@2 {
			reg = <2>;
			ioexpander2: gpio@20 {
				status = "disabled";
				compatible = "nxp,pcal6416";
				reg = <0x20>;
				gpio-controller;
				#gpio-cells = <2>;
			};
		};
		i2c-mux@4 {
			reg = <4>;
			sfp28_expander: gpio@20 {
				status = "disabled";
				compatible = "nxp,pcal6416";
				reg = <0x20>;
				gpio-controller;
				#gpio-cells = <2>;
			};
		};
	};
};

&i2c_user {
	i2c-mux@75 {
		compatible = "nxp,pca9547";
		reg = <0x75>;
		#address-cells = <1>;
		#size-cells = <0>;
		i2c-mux@5 {
			reg = <5>;
			si5395_0: si5395-0@68 {
				status = "disabled";
				reg = <0x68>;
			};
			si5395_1: si5395-1@68 {
				status = "disabled";
				reg = <0x68>;
			};
		};
	};
};

&sdhci1 {
	status = "okay";
	/* no-1-8-v; */	/* for 1.0 silicon */
	wp-inverted;
	xlnx,mio_bank = <1>;
};

&usb0 {
	status = "okay";
};

&dwc3_0 {
	status = "okay";
	dr_mode = "otg";
	snps,usb3_lpm_capable;
	phy-names = "usb3-phy";
	phys = <&psgtr 2 PHY_TYPE_USB3 0 2>;
	maximum-speed = "super-speed";
};

&zynqmp_dpsub {
	status = "okay";
	phy-names = "dp-phy0", "dp-phy1";
	phys = <&psgtr 1 PHY_TYPE_DP 0 3>, <&psgtr 0 PHY_TYPE_DP 1 3>;
	dma-names = "vid0", "vid1", "vid2", "gfx0";
	dmas = <&zynqmp_dpdma 0>, <&zynqmp_dpdma 1>, <&zynqmp_dpdma 2>, <&zynqmp_dpdma 3>;
};

&zynqmp_dpdma {
	status = "okay";
};
