/ {
	aliases {
		ethernet0 = &gem1;
		ethernet1 = &gem3;
		i2c0 = &i2c_mgmt;
		i2c1 = &i2c_user;
		serial0 = &uart0;
		spi0 = &qspi;
	};
};

&gem1 {
	phy-mode = "rgmii-id";
	phy-handle = <&phy0>;
	phy0: phy@7 {
		reg = <7>;

		txc-skew-ps = <900>;
		txen-skew-ps = <420>;

		txd0-skew-ps = <420>;
		txd1-skew-ps = <420>;
		txd2-skew-ps = <420>;
		txd3-skew-ps = <420>;

		rxc-skew-ps = <900>;
		rxdv-skew-ps = <420>;

		rxd0-skew-ps = <420>;
		rxd1-skew-ps = <420>;
		rxd2-skew-ps = <420>;
		rxd3-skew-ps = <420>;		
	};
};

&gem3 {
	phy-handle = <&phy1>;
	phy-mode = "rgmii-id";
	phy1: phy@3 {
		reg = <3>;

		txc-skew-ps = <1800>;
		txen-skew-ps = <420>;

		txd0-skew-ps = <420>;
		txd1-skew-ps = <420>;
		txd2-skew-ps = <420>;
		txd3-skew-ps = <420>;

		rxc-skew-ps = <900>;
		rxdv-skew-ps = <420>;

		rxd0-skew-ps = <420>;
		rxd1-skew-ps = <420>;
		rxd2-skew-ps = <420>;
		rxd3-skew-ps = <420>;		
	};
};

&qspi {
	#address-cells = <1>;
	#size-cells = <0>;
	is-dual = <1>;
	num-cs = <2>;
	flash0: flash@0 {
		reg = <0x0>;
		compatible = "spansion,s25fl512s", "jedec,spi-nor";
		spi-rx-bus-width = <0x4>;
		spi-tx-bus-width = <0x4>;
		spi-max-frequency = <50000000>;
		#address-cells = <1>;
		#size-cells = <1>;
	};
};

&psgtr {
	clocks = <&ref100>, <&ref27>;
	clock-names = "ref2", "ref3";
};

&amba {
	ref100: ref100M {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <100000000>;
	};
	ref27: ref27M {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <27000000>;
	};
	i2c_mgmt: i2c@ff020000 {
		clock-frequency = <100000>;
		atsha204a@64 {
			compatible = "atmel,atsha204a";
			reg = <0x64>;
		};
	};
	i2c_user: i2c@ff030000 {
		clock-frequency = <100000>;
		scl-gpios = <&gpio 10 GPIO_ACTIVE_HIGH>;
		sda-gpios = <&gpio 11 GPIO_ACTIVE_HIGH>;
	};
};

&sdhci1 {
	no-1-8-v;	/* for 1.0 silicon */
	wp-inverted;
	xlnx,mio_bank = <1>;
};
