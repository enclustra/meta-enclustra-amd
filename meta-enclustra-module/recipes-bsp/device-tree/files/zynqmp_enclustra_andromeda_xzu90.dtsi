/ {
	aliases {
		i2c0 = &i2c_mgmt;
		i2c1 = &i2c_user;
	};
};

&gem1 {
	/delete-property/ local-mac-address;
	phy-mode = "rgmii";
	phy-handle = <&phy1>;
	mdio {
		// KSZ9031 (PL)
		phy1: phy@7 {
			reg = <7>;

			// 0 ns TX clock delay
			txc-skew-ps = <900>;
			txen-skew-ps = <420>;

			txd0-skew-ps = <420>;
			txd1-skew-ps = <420>;
			txd2-skew-ps = <420>;
			txd3-skew-ps = <420>;

			// -0.18 ns RX clock delay
			rxc-skew-ps = <0>;
			rxdv-skew-ps = <900>;

			rxd0-skew-ps = <900>;
			rxd1-skew-ps = <900>;
			rxd2-skew-ps = <900>;
			rxd3-skew-ps = <900>;
		};
	};
};

&gem3 {
	/delete-property/ local-mac-address;
	phy-handle = <&phy0>;
	phy-mode = "rgmii-id";
	mdio {
		// KSZ9031 (PS)
		phy0: phy@3 {
			reg = <3>;

			// 0.9 ns TX clock delay
			txc-skew-ps = <1800>;
			txen-skew-ps = <420>;

			txd0-skew-ps = <420>;
			txd1-skew-ps = <420>;
			txd2-skew-ps = <420>;
			txd3-skew-ps = <420>;

			// 1.2 ns RX clock delay
			rxc-skew-ps = <900>;
			rxdv-skew-ps = <420>;

			rxd0-skew-ps = <420>;
			rxd1-skew-ps = <420>;
			rxd2-skew-ps = <420>;
			rxd3-skew-ps = <420>;
		};
	};
};

&qspi {
	#address-cells = <1>;
	#size-cells = <0>;
	is-dual = <1>;
	num-cs = <2>;
	flash0: flash@0 {
		reg = <0x0>;
		compatible = "spansion,s25fl512s", "jedec,spi-nor";
		parallel-memories = /bits/ 64 <0x4000000 0x4000000>; /* 128MB */
		spi-rx-bus-width = <0x4>;
		spi-tx-bus-width = <0x4>;
		spi-max-frequency = <50000000>;
		#address-cells = <1>;
		#size-cells = <1>;
	};
};

&psgtr {
	clocks = <&ref100>, <&ref27>;
	clock-names = "ref2", "ref3";
};

&amba {
	ref100: ref100M {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <100000000>;
	};
	ref27: ref27M {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <27000000>;
	};
	i2c_mgmt: i2c@ff020000 {
		clock-frequency = <100000>;
		atsha204a@64 {
			compatible = "atmel,atsha204a";
			reg = <0x64>;
		};
		irps5401@43 {
			compatible = "infineon,irps5401";
			reg = <0x43>;
		};
		irps5401@4d {
			compatible = "infineon,irps5401";
			reg = <0x4d>;
		};
		irps5401@4f {
			compatible = "infineon,irps5401";
			reg = <0x4f>;
		};
		slb9673@2e {
			compatible = "infineon,slb9673", "tcg,tpm_tis-i2c";
			reg = <0x2e>;
		};
	};
	i2c_user: i2c@ff030000 {
		clock-frequency = <100000>;
	};
};
