if [ -n "$BASH_SOURCE" ]; then
    export ROOT=$( readlink -f $( dirname "$BASH_SOURCE" ) )
elif [ -n "$ZSH_NAME" ]; then
    export ROOT=$( readlink -f $( dirname "$0" ) )
else
    export ROOT=$( readlink -f $PWD )
fi

## fix: "ERROR: Unable to get checksum for ", typically device-tree and so on..
export PROOT="$ROOT"
export TEMPLATECONF=$ROOT/sources/meta-petalinux/conf/templates/default

## apply internal layer if checked out
if [ -d $ROOT/sources/meta-xilinx-internal ]; then
    export TEMPLATECONF=$ROOT/sources/meta-xilinx-internal/conf/templates/default
fi

## in case not already done, append PATH
if [ -z "$( echo $PATH | grep "$ROOT/scripts" )" ]; then
    export PATH=$PATH:$ROOT/scripts
fi
if [ -z "$( echo $PATH | grep "meta-xilinx/meta-xilinx-core/gen-machine-conf" )" ]; then
    if [ -d $ROOT/sources/meta-xilinx/meta-xilinx-core/gen-machine-conf ]; then
        export PATH=$PATH:$ROOT/sources/meta-xilinx/meta-xilinx-core/gen-machine-conf
    fi
fi

## translate environment variables old to new
if [ -n "$BB_ENV_WHITELIST" ]; then
    export BB_ENV_PASSTHROUGH="$BB_ENV_WHITELIST"
    unset BB_ENV_WHITELIST
fi
if [ -n "$BB_ENV_EXTRAWHITE" ]; then
    export BB_ENV_PASSTHROUGH_ADDITIONS="$BB_ENV_EXTRAWHITE"
    unset BB_ENV_EXTRAWHITE
fi
source $ROOT/sources/poky/oe-init-build-env "$@"

## provide path to find sources, make internal indexing use this path
export ENCLUSTRA_SOURCE_DIR="@@TODO@@"
if [ -z "$( echo $BB_ENV_PASSTHROUGH_ADDITIONS | grep "ENCLUSTRA_SOURCE_DIR" )" ]; then
    export BB_ENV_PASSTHROUGH_ADDITIONS="$BB_ENV_PASSTHROUGH_ADDITIONS ENCLUSTRA_SOURCE_DIR PROOT"
fi

## enclustra.inc
PROJECT_SPEC_DIR="$ROOT/sources/meta-enclustra/project-spec"
if [ -d $PROJECT_SPEC_DIR/machine ]; then
    cp -arf $ROOT/sources/meta-enclustra/project-spec/machine $ROOT/build/conf/
fi

if [ -f $PROJECT_SPEC_DIR/plnxtool.conf.sample ]; then
    cp -af $PROJECT_SPEC_DIR/plnxtool.conf.sample $ROOT/build/conf/plnxtool.conf
fi

if [ -f $PROJECT_SPEC_DIR/bblayers.conf.sample ]; then
    cp -af $PROJECT_SPEC_DIR/bblayers.conf.sample $ROOT/build/conf/bblayers.conf
fi

if [ -f $PROJECT_SPEC_DIR/enclustra.inc ]; then
    cp -af $PROJECT_SPEC_DIR/enclustra.inc $ROOT/build/conf/
fi

## local.conf adjustments
result="$( grep "plnxtool.conf" -r $ROOT/build/conf/local.conf | grep -v "^#" )" || true
if [ -z "$result" ]; then
    echo "include conf/plnxtool.conf" >> $ROOT/build/conf/local.conf
fi

result="$( grep "enclustra.inc" -r $ROOT/build/conf/local.conf | grep -v "^#" )" || true
if [ -z "$result" ]; then
    echo "require conf/enclustra.inc" >> $ROOT/build/conf/local.conf
fi

result="$( grep "petalinuxbsp.conf" -r $ROOT/build/conf/local.conf | grep -v "^#" )" || true
if [ -z "$result" ]; then
    echo "include conf/petalinuxbsp.conf" >> $ROOT/build/conf/local.conf
fi

echo "READY."
